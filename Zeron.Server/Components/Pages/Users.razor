@page "/users"
@rendermode InteractiveServer
@using Zeron.Server.ZCore
@using Zeron.Server.ZCore.Type
@using Zeron.Server.ZServers
@attribute [Authorize(Policy = ServerPolicies.AdminOnly)]
@inject UserManagerServer UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageHeader Title="Users" Subtitle="Manage dashboard accounts and roles." />

<div class="panel">
    <h2>Create User</h2>
    <div class="form-grid">
        <label>
            Username
            <InputText id="user-create-username"
                       @bind-Value="m_CreateModel.Username"
                       aria-invalid="@(!string.IsNullOrWhiteSpace(m_UsernameError))"
                       aria-describedby="@FormFieldValidation.DescribedBy("user-create-username-error", m_UsernameError)" />
            <FormFieldError Id="user-create-username-error" Message="@m_UsernameError" />
        </label>
        <label>
            Password
            <InputText id="user-create-password"
                       type="password"
                       @bind-Value="m_CreateModel.Password"
                       aria-invalid="@(!string.IsNullOrWhiteSpace(m_PasswordError))"
                       aria-describedby="@FormFieldValidation.DescribedBy("user-create-password-error", m_PasswordError)" />
            <FormFieldError Id="user-create-password-error" Message="@m_PasswordError" />
        </label>
        <label>
            Role
            <InputSelect @bind-Value="m_CreateModel.Role">
                <option value="@ServerRoles.Viewer">Viewer</option>
                <option value="@ServerRoles.Operator">Operator</option>
                <option value="@ServerRoles.Admin">Admin</option>
                <option value="@ServerRoles.DeviceOwner">DeviceOwner</option>
            </InputSelect>
        </label>
        <label>
            Email (optional)
            <InputText id="user-create-email"
                       @bind-Value="m_CreateModel.Email"
                       aria-invalid="@(!string.IsNullOrWhiteSpace(m_EmailError))"
                       aria-describedby="@FormFieldValidation.DescribedBy("user-create-email-error", m_EmailError)" />
            <FormFieldError Id="user-create-email-error" Message="@m_EmailError" />
        </label>
        <div class="actions">
            <LoadingButton CssClass="btn"
                            Text="Create User"
                            IsLoading="@m_IsBusy"
                            OnClick="CreateUserAsync" />
        </div>
    </div>
    @if (!string.IsNullOrWhiteSpace(m_CreateMessage))
    {
        <NotificationBanner Success="@m_CreateSucceeded" Message="@m_CreateMessage" />
    }
</div>

<div class="panel">
    <h2>Existing Users</h2>
    @if (m_Rows.Count == 0)
    {
        <EmptyState Title="No users found"
                    Message="Create a dashboard account above to grant access." />
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Username</th>
                    <th>Role</th>
                    <th>Email</th>
                    <th>Status</th>
                    <th>Password</th>
                    <th>Created</th>
                    <th>Reset Password</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (UserEditRowType row in m_Rows)
                {
                    <tr>
                        <td>@row.Username</td>
                        <td>
                            <InputSelect @bind-Value="row.Role" disabled="@m_IsBusy">
                                <option value="@ServerRoles.Viewer">Viewer</option>
                                <option value="@ServerRoles.Operator">Operator</option>
                                <option value="@ServerRoles.Admin">Admin</option>
                                <option value="@ServerRoles.DeviceOwner">DeviceOwner</option>
                            </InputSelect>
                        </td>
                        <td>
                            <InputText @bind-Value="row.Email"
                                       placeholder="notify@example.com"
                                       disabled="@m_IsBusy" />
                        </td>
                        <td>
                            <span class="status @(row.IsActive ? "online" : "offline")">
                                @(row.IsActive ? "active" : "inactive")
                            </span>
                        </td>
                        <td>
                            @if (row.MustChangePassword)
                            {
                                <span class="status stale">must change</span>
                            }
                            else
                            {
                                <span class="status healthy">ok</span>
                            }
                        </td>
                        <td>@(row.CreatedAt?.ToLocalTime().ToString("g") ?? "-")</td>
                        <td>
                            <InputText type="password"
                                       @bind-Value="row.NewPassword"
                                       placeholder="New password"
                                       disabled="@m_IsBusy" />
                        </td>
                        <td>
                            <div class="actions">
                                <LoadingButton CssClass="btn btn-secondary"
                                                Text="Save"
                                                IsLoading="@m_IsBusy"
                                                OnClick="() => SaveUserAsync(row)" />
                                @if (row.IsActive)
                                {
                                    <LoadingButton CssClass="btn btn-danger"
                                                    Text="Deactivate"
                                                    IsLoading="@m_IsBusy"
                                                    Disabled="@(m_IsBusy || row.Id == m_CurrentUserId)"
                                                    OnClick="() => RequestDeactivate(row)" />
                                }
                                else
                                {
                                    <LoadingButton CssClass="btn btn-secondary"
                                                    Text="Activate"
                                                    IsLoading="@m_IsBusy"
                                                    Disabled="@m_IsBusy"
                                                    OnClick="() => SetActiveAsync(row, true)" />
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (!string.IsNullOrWhiteSpace(m_UpdateMessage))
    {
        <NotificationBanner Success="@m_UpdateSucceeded" Message="@m_UpdateMessage" />
    }
</div>

<ConfirmDialog IsOpen="@(m_PendingDeactivate != null)"
               Title="Deactivate user?"
               Message="@($"Deactivate '{m_PendingDeactivate?.Username}'? They will no longer be able to sign in.")"
               ConfirmText="Deactivate"
               IsBusy="@m_IsBusy"
               OnConfirm="ConfirmDeactivateAsync"
               OnCancel="CloseDeactivateConfirm" />
