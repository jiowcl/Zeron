@page "/login"
@layout EmptyLayout
@attribute [AllowAnonymous]
@rendermode InteractiveServer

<div class="login-page">
    <div class="login-card">
        <div class="brand" style="margin-bottom: 1.5rem;">
            <span class="brand-mark">Z</span>
            <div>
                <strong>Zeron Server</strong>
                <small>Dashboard Login</small>
            </div>
        </div>

        <form method="post" action="/account/login">
            <AntiforgeryToken />
            <div class="form-grid">
                <label>
                    Username
                    <input name="username"
                           id="login-username"
                           @ref="m_UsernameInput"
                           value="@m_Username"
                           required
                           autocomplete="username"
                           aria-invalid="@(!string.IsNullOrWhiteSpace(m_UsernameError))"
                           aria-describedby="@(string.IsNullOrWhiteSpace(m_UsernameError) ? null : "login-username-error")" />
                    <FormFieldError Id="login-username-error" Message="@m_UsernameError" />
                </label>
                <label>
                    Password
                    <input name="password"
                           id="login-password"
                           @ref="m_PasswordInput"
                           type="password"
                           required
                           autocomplete="current-password"
                           aria-invalid="@(!string.IsNullOrWhiteSpace(m_PasswordError))"
                           aria-describedby="@(string.IsNullOrWhiteSpace(m_PasswordError) ? null : "login-password-error")" />
                    <FormFieldError Id="login-password-error" Message="@m_PasswordError" />
                </label>
                <button class="btn" type="submit">Sign In</button>
            </div>
        </form>

        @if (!string.IsNullOrWhiteSpace(m_Error))
        {
            <NotificationBanner Success="false" Message="@m_Error" />
        }
    </div>
</div>
