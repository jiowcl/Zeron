@page "/tasks/create"
@rendermode InteractiveServer
@using Zeron.Server.ZServers
@using Zeron.ZCore.Type
@attribute [Authorize(Policy = ServerPolicies.OperatorOrAbove)]
@inject TaskDispatcherServer TaskDispatcher
@inject NavigationManager Navigation

<PageHeader Title="Create Task"
            Subtitle="Dispatch a remote API command to selected agents."
            Breadcrumbs="c_TaskBreadcrumbs" />

<div class="panel">
    <div class="form-grid">
        <label>
            Name
            <InputText id="task-name"
                       @bind-Value="m_Model.Name"
                       aria-invalid="@(!string.IsNullOrWhiteSpace(m_NameError))"
                       aria-describedby="@FormFieldValidation.DescribedBy("task-name-error", m_NameError)" />
            <FormFieldError Id="task-name-error" Message="@m_NameError" />
        </label>
        <label>
            Description
            <InputText @bind-Value="m_Model.Description" />
        </label>
        <label>
            Target API
            <InputText id="task-target-api"
                       @bind-Value="m_Model.TargetApi"
                       aria-invalid="@(!string.IsNullOrWhiteSpace(m_TargetApiError))"
                       aria-describedby="@FormFieldValidation.DescribedBy("task-target-api-error", m_TargetApiError)" />
            <FormFieldError Id="task-target-api-error" Message="@m_TargetApiError" />
        </label>
        <label>
            Command
            <InputText id="task-command"
                       @bind-Value="m_Model.Command"
                       aria-invalid="@(!string.IsNullOrWhiteSpace(m_CommandError))"
                       aria-describedby="@FormFieldValidation.DescribedBy("task-command-error", m_CommandError)" />
            <FormFieldError Id="task-command-error" Message="@m_CommandError" />
        </label>
        <label>
            Target Type
            <InputSelect @bind-Value="m_Model.TargetType">
                <option value="all">All Online Agents</option>
                <option value="agent">Specific Agent</option>
                <option value="filter">Hostname Filter</option>
            </InputSelect>
        </label>
        @if (m_Model.TargetType == "agent")
        {
            <label>
                Agent Id
                <InputText id="task-agent-id"
                           @bind-Value="m_Model.AgentId"
                           aria-invalid="@(!string.IsNullOrWhiteSpace(m_AgentIdError))"
                           aria-describedby="@FormFieldValidation.DescribedBy("task-agent-id-error", m_AgentIdError)" />
                <FormFieldError Id="task-agent-id-error" Message="@m_AgentIdError" />
            </label>
        }
        @if (m_Model.TargetType == "filter")
        {
            <label>
                Hostname Pattern
                <InputText id="task-hostname"
                           @bind-Value="m_Model.HostnamePattern"
                           aria-invalid="@(!string.IsNullOrWhiteSpace(m_HostnameError))"
                           aria-describedby="@FormFieldValidation.DescribedBy("task-hostname-error", m_HostnameError)" />
                <FormFieldError Id="task-hostname-error" Message="@m_HostnameError" />
            </label>
        }
        <div class="actions">
            <LoadingButton CssClass="btn"
                            Text="Create Task"
                            IsLoading="@m_IsSubmitting"
                            OnClick="HandleCreateAsync" />
            <a class="btn btn-secondary" href="/tasks">Cancel</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(m_Error))
    {
        <NotificationBanner Success="false" Message="@m_Error" />
    }
</div>
