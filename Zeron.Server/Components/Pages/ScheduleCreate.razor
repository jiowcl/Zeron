@page "/schedules/create"
@rendermode InteractiveServer
@using Zeron.Server.ZServers
@using Zeron.ZCore.Type
@attribute [Authorize(Policy = ServerPolicies.OperatorOrAbove)]
@inject TaskScheduleServer TaskScheduleServer
@inject NavigationManager Navigation

<PageHeader Title="Create Schedule"
            Subtitle="Define a cron expression and the remote API to dispatch when due."
            Breadcrumbs="c_ScheduleBreadcrumbs" />

<div class="panel">
    <div class="form-grid">
        <label>
            Name
            <InputText id="schedule-name"
                       @bind-Value="m_Model.Name"
                       aria-invalid="@(!string.IsNullOrWhiteSpace(m_NameError))"
                       aria-describedby="@FormFieldValidation.DescribedBy("schedule-name-error", m_NameError)" />
            <FormFieldError Id="schedule-name-error" Message="@m_NameError" />
        </label>
        <label>
            Description
            <InputText @bind-Value="m_Model.Description" />
        </label>
        <label>
            Cron Expression
            <InputText id="schedule-cron"
                       @bind-Value="m_Model.Cron"
                       aria-invalid="@(!string.IsNullOrWhiteSpace(m_CronError))"
                       aria-describedby="@FormFieldValidation.DescribedBy("schedule-cron-error", m_CronError)" />
            <FormFieldError Id="schedule-cron-error" Message="@m_CronError" />
            <small class="muted">5-field NCrontab, evaluated in server local time. Example: <code>0 8 * * *</code> daily at 08:00</small>
        </label>
        <label>
            Target API
            <InputText id="schedule-target-api"
                       @bind-Value="m_Model.TargetApi"
                       aria-invalid="@(!string.IsNullOrWhiteSpace(m_TargetApiError))"
                       aria-describedby="@FormFieldValidation.DescribedBy("schedule-target-api-error", m_TargetApiError)" />
            <FormFieldError Id="schedule-target-api-error" Message="@m_TargetApiError" />
        </label>
        <label>
            Command
            <InputText id="schedule-command"
                       @bind-Value="m_Model.Command"
                       aria-invalid="@(!string.IsNullOrWhiteSpace(m_CommandError))"
                       aria-describedby="@FormFieldValidation.DescribedBy("schedule-command-error", m_CommandError)" />
            <FormFieldError Id="schedule-command-error" Message="@m_CommandError" />
        </label>
        <label>
            Target Type
            <InputSelect @bind-Value="m_Model.TargetType">
                <option value="all">All Online Agents</option>
                <option value="agent">Specific Agent</option>
                <option value="filter">Hostname Filter</option>
            </InputSelect>
        </label>
        @if (m_Model.TargetType == "agent")
        {
            <label>
                Agent Id
                <InputText id="schedule-agent-id"
                           @bind-Value="m_Model.AgentId"
                           aria-invalid="@(!string.IsNullOrWhiteSpace(m_AgentIdError))"
                           aria-describedby="@FormFieldValidation.DescribedBy("schedule-agent-id-error", m_AgentIdError)" />
                <FormFieldError Id="schedule-agent-id-error" Message="@m_AgentIdError" />
            </label>
        }
        @if (m_Model.TargetType == "filter")
        {
            <label>
                Hostname Pattern
                <InputText id="schedule-hostname"
                           @bind-Value="m_Model.HostnamePattern"
                           aria-invalid="@(!string.IsNullOrWhiteSpace(m_HostnameError))"
                           aria-describedby="@FormFieldValidation.DescribedBy("schedule-hostname-error", m_HostnameError)" />
                <FormFieldError Id="schedule-hostname-error" Message="@m_HostnameError" />
            </label>
        }
        <label class="checkbox-row">
            <InputCheckbox @bind-Value="m_Model.Enabled" />
            <span>Enabled</span>
        </label>
        <div class="actions">
            <LoadingButton CssClass="btn"
                            Text="Create Schedule"
                            IsLoading="@m_IsSubmitting"
                            OnClick="HandleCreateAsync" />
            <a class="btn btn-secondary" href="/schedules">Cancel</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(m_Error))
    {
        <NotificationBanner Success="false" Message="@m_Error" />
    }

    <div class="cron-examples">
        <h3>Common cron examples</h3>
        <ul>
            <li><code>*/5 * * * *</code> — every 5 minutes</li>
            <li><code>0 * * * *</code> — every hour</li>
            <li><code>0 8 * * *</code> — every day at 08:00</li>
            <li><code>0 9 * * 1</code> — every Monday at 09:00</li>
        </ul>
    </div>
</div>
