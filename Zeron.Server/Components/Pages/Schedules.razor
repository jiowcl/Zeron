@page "/schedules"
@rendermode InteractiveServer
@using Zeron.Server.ZServers
@using Zeron.ZCore.Type
@attribute [Authorize(Policy = ServerPolicies.ViewerOrAbove)]
@inject TaskScheduleServer TaskScheduleServer

<PageHeader Title="Schedules" Subtitle="Cron-based task schedules that dispatch to agents.">
    <LoadingButton CssClass="btn btn-secondary"
                    Text="Refresh"
                    IsLoading="@m_IsBusy"
                    OnClick="ReloadAsync" />
    <AuthorizeView Roles="@($"{ServerRoles.Admin},{ServerRoles.Operator}")">
        <Authorized>
            <a class="btn" href="/schedules/create">Create Schedule</a>
        </Authorized>
    </AuthorizeView>
</PageHeader>

<div class="panel">
    @if (m_Schedules.Count == 0)
    {
        <EmptyState Title="No schedules yet"
                    Message="Create a cron schedule to run tasks automatically.">
            <Actions>
                <AuthorizeView Roles="@($"{ServerRoles.Admin},{ServerRoles.Operator}")">
                    <Authorized>
                        <a class="btn" href="/schedules/create">Create Schedule</a>
                    </Authorized>
                </AuthorizeView>
            </Actions>
        </EmptyState>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Cron</th>
                    <th>Target API</th>
                    <th>Status</th>
                    <th>Next Run</th>
                    <th>Last Run</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (TaskScheduleInfoType schedule in m_Schedules)
                {
                    <tr>
                        <td>@schedule.Name</td>
                        <td><code>@schedule.Cron</code></td>
                        <td>@schedule.TargetApi</td>
                        <td>
                            <span class="status @(schedule.Enabled ? "online" : "disabled")">
                                @(schedule.Enabled ? "enabled" : "disabled")
                            </span>
                        </td>
                        <td>@(schedule.NextRunAt?.ToLocalTime().ToString("g") ?? "-")</td>
                        <td>@(schedule.LastRunAt?.ToLocalTime().ToString("g") ?? "-")</td>
                        <td><a href="@($"/schedules/{schedule.Id}")">Details</a></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
