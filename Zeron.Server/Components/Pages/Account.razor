@page "/account"
@rendermode InteractiveServer
@using Zeron.Server.ZServers
@using Zeron.ZCore.Type
@attribute [Authorize(Policy = ServerPolicies.DeviceOwnerOrStaff)]
@inject AuthServer AuthServer
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageHeader Title="Account" Subtitle="Update your notification email and password.">
    <a class="btn btn-secondary" href="@m_HomePath">Back</a>
</PageHeader>

@if (m_Profile == null)
{
    <div class="panel"><p>Loading account...</p></div>
}
else
{
    <div class="cards" style="margin-bottom: 1.5rem;">
        <div class="card"><span>Username</span><strong>@m_Profile.Username</strong></div>
        <div class="card"><span>Role</span><strong>@m_Profile.Role</strong></div>
    </div>

    <div class="panel">
        <h2>Notification Email</h2>
        <p class="muted">Used for self-service install result emails when <code>InstallResultEmailEnabled</code> is on.</p>
        <div class="form-grid">
            <label>
                Email
                <InputText id="account-email"
                           @bind-Value="m_Email"
                           autocomplete="email"
                           aria-invalid="@(!string.IsNullOrWhiteSpace(m_EmailError))"
                           aria-describedby="@FormFieldValidation.DescribedBy("account-email-error", m_EmailError)" />
                <FormFieldError Id="account-email-error" Message="@m_EmailError" />
                <small class="muted">Leave blank to clear.</small>
            </label>
            <div class="actions">
                <LoadingButton CssClass="btn"
                                Text="Save Email"
                                IsLoading="@m_IsBusy"
                                OnClick="SaveEmailAsync" />
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(m_EmailMessage))
        {
            <NotificationBanner Success="@m_EmailSucceeded" Message="@m_EmailMessage" />
        }
    </div>

    <div class="panel">
        <h2>Change Password</h2>
        <div class="form-grid">
            <label>
                Current Password
                <InputText id="account-current-password"
                           type="password"
                           @bind-Value="m_CurrentPassword"
                           autocomplete="current-password"
                           aria-invalid="@(!string.IsNullOrWhiteSpace(m_CurrentPasswordError))"
                           aria-describedby="@FormFieldValidation.DescribedBy("account-current-password-error", m_CurrentPasswordError)" />
                <FormFieldError Id="account-current-password-error" Message="@m_CurrentPasswordError" />
            </label>
            <label>
                New Password
                <InputText id="account-new-password"
                           type="password"
                           @bind-Value="m_NewPassword"
                           autocomplete="new-password"
                           aria-invalid="@(!string.IsNullOrWhiteSpace(m_NewPasswordError))"
                           aria-describedby="@FormFieldValidation.DescribedBy("account-new-password-error", m_NewPasswordError)" />
                <FormFieldError Id="account-new-password-error" Message="@m_NewPasswordError" />
                <small class="muted">At least 6 characters.</small>
            </label>
            <label>
                Confirm New Password
                <InputText id="account-confirm-password"
                           type="password"
                           @bind-Value="m_ConfirmPassword"
                           autocomplete="new-password"
                           aria-invalid="@(!string.IsNullOrWhiteSpace(m_ConfirmPasswordError))"
                           aria-describedby="@FormFieldValidation.DescribedBy("account-confirm-password-error", m_ConfirmPasswordError)" />
                <FormFieldError Id="account-confirm-password-error" Message="@m_ConfirmPasswordError" />
            </label>
            <div class="actions">
                <LoadingButton CssClass="btn"
                                Text="Update Password"
                                IsLoading="@m_IsBusy"
                                OnClick="SavePasswordAsync" />
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(m_PasswordMessage))
        {
            <NotificationBanner Success="@m_PasswordSucceeded" Message="@m_PasswordMessage" />
        }
    </div>
}
