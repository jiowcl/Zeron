@page "/account/change-password"
@layout EmptyLayout
@attribute [Authorize(Policy = ServerPolicies.DeviceOwnerOrStaff)]

<div class="login-page">
    <div class="login-card">
        <div class="brand" style="margin-bottom: 1.5rem;">
            <span class="brand-mark">Z</span>
            <div>
                <strong>Change Password</strong>
                <small>@(m_IsRequired ? "Required before continuing" : "Update your account password")</small>
            </div>
        </div>

        @if (m_IsRequired)
        {
            <p class="warning-text" role="alert">You must set a new password before using the dashboard.</p>
        }

        <form method="post" action="/account/change-password">
            <div class="form-grid">
                <label>
                    Current Password
                    <input name="currentPassword"
                           id="change-current-password"
                           type="password"
                           required
                           autocomplete="current-password"
                           aria-invalid="@(!string.IsNullOrWhiteSpace(m_CurrentPasswordError))"
                           aria-describedby="@(string.IsNullOrWhiteSpace(m_CurrentPasswordError) ? null : "change-current-password-error")" />
                    <FormFieldError Id="change-current-password-error" Message="@m_CurrentPasswordError" />
                </label>
                <label>
                    New Password
                    <input name="newPassword"
                           id="change-new-password"
                           type="password"
                           required
                           minlength="6"
                           autocomplete="new-password"
                           aria-invalid="@(!string.IsNullOrWhiteSpace(m_NewPasswordError))"
                           aria-describedby="@(string.IsNullOrWhiteSpace(m_NewPasswordError) ? null : "change-new-password-error")" />
                    <FormFieldError Id="change-new-password-error" Message="@m_NewPasswordError" />
                </label>
                <label>
                    Confirm New Password
                    <input name="confirmPassword"
                           id="change-confirm-password"
                           type="password"
                           required
                           minlength="6"
                           autocomplete="new-password"
                           aria-invalid="@(!string.IsNullOrWhiteSpace(m_ConfirmPasswordError))"
                           aria-describedby="@(string.IsNullOrWhiteSpace(m_ConfirmPasswordError) ? null : "change-confirm-password-error")" />
                    <FormFieldError Id="change-confirm-password-error" Message="@m_ConfirmPasswordError" />
                </label>
                <button class="btn" type="submit">Update Password</button>
            </div>
        </form>

        @if (!string.IsNullOrWhiteSpace(m_Error))
        {
            <NotificationBanner Success="false" Message="@m_Error" />
        }

        @if (!m_IsRequired)
        {
            <p style="margin-top: 1rem;"><a href="/account">Back to Account</a></p>
        }
        else
        {
            <form method="post" action="/account/logout" style="margin-top: 1rem;">
                <button class="btn-link" type="submit">Logout</button>
            </form>
        }
    </div>
</div>
