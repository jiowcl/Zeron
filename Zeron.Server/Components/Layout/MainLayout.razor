@inherits LayoutComponentBase
@rendermode InteractiveServer

<div class="page @(m_SidebarOpen ? "sidebar-open" : "")">
    <div class="mobile-topbar">
        <button class="sidebar-toggle btn btn-secondary"
                type="button"
                aria-label="Toggle navigation menu"
                aria-expanded="@m_SidebarOpen"
                aria-controls="app-sidebar"
                @onclick="ToggleSidebar">
            Menu
        </button>
        <div class="mobile-brand">
            <span class="brand-mark">Z</span>
            <strong>Zeron</strong>
        </div>
    </div>

    <div class="sidebar-backdrop" @onclick="CloseSidebar"></div>

    <aside id="app-sidebar" class="sidebar" aria-label="Main navigation">
        <div class="brand">
            <span class="brand-mark">Z</span>
            <div>
                <strong>Zeron</strong>
                <small>Management Server</small>
            </div>
        </div>
        <NavMenu />
    </aside>

    <main class="main">
        <article class="content">
            @Body
        </article>
    </main>
</div>
