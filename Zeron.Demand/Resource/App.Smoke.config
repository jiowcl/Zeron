<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <!-- Boot-only smoke: no Server heartbeat, no SUB connect (used by scripts/linux-smoke.sh and CI). -->
    <add key="server_enabled" value="false" />
    <add key="server_url" value="http://127.0.0.1:5000" />
    <add key="server_api_key" value="smoke-key" />
    <add key="server_hmac_enabled" value="false" />

    <add key="mp_db_source_file" value="Resource/appdb-windows.db" />
    <add key="mp_repo_temp_path" value="Resource/mp-temp" />
    <add key="mp_catalog_sync_enabled" value="false" />

    <add key="zmq_sub_enabled" value="false" />
    <add key="zmq_sub_addr" value="tcp://127.0.0.1:6000" />
    <add key="zmq_sub_api_key" value="smoke-key" />

    <add key="zmq_rep_enabled" value="false" />
    <add key="zmq_pub_enabled" value="false" />

    <add key="encryption_salt_key" value="YRjo1*9!" />
    <add key="encryption_iv_key" value="cdTeAV#$^YiuDamK" />

    <add key="script_powershell_enabled" value="false" />
    <add key="script_default_timeout_ms" value="300000" />

    <add key="script_plugins_dir" value="plugins" />
    <add key="mail_enabled" value="false" />
  </appSettings>
</configuration>